{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "firecrawl-local",
  "extensions": {
    "io.aachat": {
      "commands": [
        {
          "name": "firecrawl-local",
          "check": [
            "firecrawl-local",
            "--version"
          ]
        },
        {
          "name": "node",
          "check": [
            "node",
            "-e",
            "process.exit(Number(process.versions.node.split('.')[0]) >= 22 ? 0 : 1)"
          ]
        },
        {
          "name": "npx",
          "check": [
            "npx",
            "--version"
          ]
        }
      ]
    }
  },
  "version": "0.1.0",
  "description": "公開Webページの本文をFirecrawl Localで取得し、Agentの要約に使う。"
}
